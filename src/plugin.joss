class AI {
    func client() {
        return new ChatClient()
    }

    func chat($provider, $model, $messages) {
        $c = new ChatClient()
        (!empty($provider)) ? { $c->provider($provider) } : {}
        (!empty($model)) ? { $c->model($model) } : {}
        foreach ($messages as $m) {
            ($m["role"] == "user") ? { $c->user($m["content"]) } : {}
            ($m["role"] == "system") ? { $c->system($m["content"]) } : {}
            ($m["role"] == "assistant") ? { $c->assistant($m["content"]) } : {}
        }
        return $c->call()
    }
}

class ChatClient {
    Init constructor() {
        $this->provider_name = env("AI_PROVIDER", "groq")
        $this->model_name = env("AI_MODEL", "llama-3.3-70b-versatile")
        $this->messages = []
    }

    func provider($provider) {
        (!empty($provider)) ? { $this->provider_name = $provider } : {}
        return $this
    }

    func model($model) {
        (!empty($model)) ? { $this->model_name = $model } : {}
        return $this
    }

    func user($content) {
        $this->messages = append($this->messages, {"role": "user", "content": $content})
        return $this
    }

    func prompt($content) {
        return $this->user($content)
    }

    func system($content) {
        $this->messages = append($this->messages, {"role": "system", "content": $content})
        return $this
    }

    func assistant($content) {
        $this->messages = append($this->messages, {"role": "assistant", "content": $content})
        return $this
    }

    func call() {
        $apiKey = ""
        $url = ""
        ($this->provider_name == "groq") ? {
            $apiKey = env("GROQ_API_KEY", "")
            $url = "https://api.groq.com/openai/v1/chat/completions"
        } : {
            $apiKey = env("OPENAI_API_KEY", "")
            $url = "https://api.openai.com/v1/chat/completions"
        }

        (empty($apiKey)) ? {
            return "Error: Falta configurar la API Key de IA en el archivo .env"
        } : {}

        $payload = {
            "model": $this->model_name,
            "messages": $this->messages
        }

        $res = Http::json("POST", $url, $payload, {
            "Authorization": "Bearer " . $apiKey,
            "Content-Type": "application/json"
        })

        (!empty($res["choices"]) && count($res["choices"]) > 0) ? {
            return $res["choices"][0]["message"]["content"]
        } : {}

        (!empty($res["error"])) ? {
            $err = $res["error"]
            return (!empty($err["message"])) ? $err["message"] : JSON::stringify($err)
        } : {}

        (is_string($res) && !empty($res)) ? {
            return $res
        } : {}

        return "Error al procesar respuesta de IA"
    }

    func streamTo($ws) {
        $response = $this->call()
        $ws->send(JSON::stringify({"type": "chunk", "content": $response}))
        return $response
    }
}
